{
  "name": "ts-loader",
  "version": "10.0.0-beta.0",
  "description": "TypeScript loader for webpack",
  "main": "index.js",
  "types": "dist",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "index.js"
  ],
  "scripts": {
    "build": "tsc --version && tsc --project \"./src\"",
    "check:benchmark-tests": "tsc --version && tsc --project \"./test/benchmark-tests\"",
    "check:comparison-tests": "tsc --version && tsc --project \"./test/comparison-tests\"",
    "check:execution-tests": "tsc --version && tsc --project \"./test/execution-tests\"",
    "format": "prettier --write \"src/**/*.*\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.*\" \"*.md\"",
    "lint": "tsc --project \"./src\" --noEmit && oxlint src",
    "comparison-tests": "git clean -xfd test/comparison-tests && node test/comparison-tests/link-test-lib.js && node test/comparison-tests/run-tests.js",
    "execution-tests": "git clean -xfd test/execution-tests && node test/execution-tests/run-tests.js",
    "test": "git clean -xfd test/comparison-tests && git clean -xfd test/execution-tests && node test/run-tests.js",
    "benchmark": "node test/benchmark-tests/run-benchmark.mts",
    "clean": "git clean -xfd test/comparison-tests && git clean -xfd test/execution-tests",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TypeStrong/ts-loader.git"
  },
  "keywords": [
    "ts-loader",
    "typescript-loader",
    "webpack",
    "loader",
    "typescript",
    "ts"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "John Reilly <johnny_reilly@hotmail.com> (https://johnnyreilly.com)",
  "contributors": [
    "John Reilly <johnny_reilly@hotmail.com> (https://johnnyreilly.com)",
    "James Brantly <james@jbrantly.com> (http://www.jbrantly.com/)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TypeStrong/ts-loader/issues"
  },
  "homepage": "https://github.com/TypeStrong/ts-loader",
  "dependencies": {
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.0",
    "source-map": "^0.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@types/jasmine": "^7.0.0",
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.0",
    "babel-loader": "^8.4.1",
    "jasmine": "^7.0.0",
    "knip": "^6.30.0",
    "loader-utils": "^1.4.2",
    "mocha": "^12.0.3",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^7.1.0-beta",
    "webpack": "^5.74.0"
  },
  "peerDependencies": {
    "loader-utils": "*",
    "typescript": ">=7.1.0-beta",
    "webpack": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "loader-utils": {
      "optional": true
    }
  },
  "overrides": {
    "babel-loader": {
      "webpack": "$webpack"
    }
  },
  "publishConfig": {
    "provenance": true
  }
}
