{
  "compilerOptions": {
    "lib": ["es2018"],
    "types": ["node"],
    "target": "es2018",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "../dist",
    "declarationDir": "../dist",
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "files": [
    "./constants.ts",
    "./index.ts",
    "./instance-cache.ts",
    "./loaderUtils.ts",
    "./logger.ts",
    "./native.ts",
    "./types.ts"
  ]
}
